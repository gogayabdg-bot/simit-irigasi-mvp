<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Sinkronisasi ke server API (Bab 6.2) -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Foto geotag (Lampiran B.2): implementasi kamera/lokasi menyusul -->

  <application
      android:label="@string/app_name"
      android:icon="@android:mipmap/sym_def_app_icon"
      android:allowBackup="false"
      android:supportsRtl="true"
      android:theme="@style/Theme.SIMIT">
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- Deep link dari notifikasi push (Lampiran B.3 butir 5) -->
      <intent-filter android:autoVerify="false">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:scheme="simit" android:host="pembacaan" />
      </intent-filter>
    </activity>
  </application>
</manifest>
